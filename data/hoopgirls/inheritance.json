            <small id="auth-confirm-hint">再输入一次密码</small>
          </div>
          <!-- 注册与登录同一张表单，但不拆成「先注册再验证」两步。验证码只交给 /api/auth/register，不走 verify。 -->
          <div id="auth-register-extra" hidden>
            <div class="auth-field">
              <label for="auth-register-email" id="auth-register-email-label">邮箱</label>
              <input id="auth-register-email" name="email" type="email" maxlength="254" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" data-hint-id="auth-register-email-hint" aria-errormessage="auth-error">
              <small id="auth-register-email-hint">用来接收注册验证码</small>
            </div>
            <div class="auth-field">
              <span class="auth-turnstile-label" id="auth-register-turnstile-label">人机验证</span>
              <div id="auth-register-turnstile-slot" class="auth-turnstile-slot"></div>
            </div>
            <div class="auth-field" id="auth-register-code-field" hidden>
