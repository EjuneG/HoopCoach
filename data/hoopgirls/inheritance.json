            </div>
            <p class="auth-email-status" id="auth-register-status" role="status" hidden></p>
          </div>
          <p class="share-form-error" id="auth-error" role="alert" tabindex="-1" hidden></p>
          <div class="auth-actions">
            <button type="button" class="button ghost" id="auth-cancel">取消</button>
            <button type="button" class="button ghost" id="auth-register-send" hidden>发送验证码</button>
            <button type="submit" class="button primary" id="auth-submit">登录</button>
          </div>
        </form>
        <div class="auth-links" id="auth-email-switch">
          <button type="button" class="button ghost auth-email-entry" id="auth-email-open">邮箱验证码登录</button>
          <button type="button" class="text-button auth-reset-entry" id="auth-reset-open">忘记密码</button>
        </div>
        <form id="auth-email-form" method="post" action="#auth-email" novalidate hidden>
          <div class="auth-field">
            <label for="auth-email" id="auth-email-label">邮箱</label>
            <input id="auth-email" name="email" type="email" maxlength="254" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" data-hint-id="auth-email-hint" aria-errormessage="auth-email-error">
