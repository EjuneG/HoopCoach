          </div>
          <div class="auth-field">
            <span class="auth-turnstile-label" id="auth-turnstile-label">人机验证</span>
            <!-- data-action 必须是 email-request。site key 由 auth.js 写入；令牌放进 JSON 的 turnstile_token，不要在浏览器调用 siteverify。 -->
            <div id="auth-email-turnstile-slot" class="auth-turnstile-slot">
              <div id="auth-turnstile" class="auth-turnstile" data-action="email-request" role="group" aria-labelledby="auth-turnstile-label" tabindex="-1"></div>
            </div>
          </div>
          <div class="auth-field" id="auth-code-field" hidden>
            <label for="auth-code" id="auth-code-label">验证码</label>
            <input id="auth-code" class="auth-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" spellcheck="false" data-hint-id="auth-code-hint" aria-errormessage="auth-email-error">
            <small id="auth-code-hint">6 位数字，10 分钟内有效</small>
