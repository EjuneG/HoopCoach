              <input id="auth-register-code" class="auth-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" spellcheck="false" data-hint-id="auth-register-code-hint" aria-errormessage="auth-error">
