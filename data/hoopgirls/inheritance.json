      <div class="auth-body">
        <div class="auth-tabs" id="auth-tabs" role="tablist" aria-label="登录或注册">
          <button type="button" role="tab" id="auth-tab-login" aria-controls="auth-form" aria-selected="true">登录</button>
          <button type="button" role="tab" id="auth-tab-register" aria-controls="auth-form" aria-selected="false" tabindex="-1">注册</button>
