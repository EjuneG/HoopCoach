          </div>
          <div class="auth-field">
            <label for="auth-reset-password-confirm" id="auth-reset-confirm-label">确认新密码</label>
            <input id="auth-reset-password-confirm" name="new_password_confirm" type="password" maxlength="72" autocomplete="new-password" spellcheck="false" data-hint-id="auth-reset-confirm-hint" aria-errormessage="auth-reset-error">
            <small id="auth-reset-confirm-hint">再输入一次新密码</small>
          </div>
          <div class="auth-field">
            <span class="auth-turnstile-label" id="auth-reset-turnstile-label">人机验证</span>
            <div id="auth-reset-turnstile-slot" class="auth-turnstile-slot"></div>
          </div>
          <div class="auth-field" id="auth-reset-code-field" hidden>
            <label for="auth-reset-code" id="auth-reset-code-label">验证码</label>
            <input id="auth-reset-code" class="auth-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" spellcheck="false" data-hint-id="auth-reset-code-hint" aria-errormessage="auth-reset-error">
            <small id="auth-reset-code-hint">6 位数字，10 分钟内有效</small>
          </div>
          <p class="auth-email-status" id="auth-reset-status" role="status" hidden></p>
          <p class="share-form-error" id="auth-reset-error" role="alert" tabindex="-1" hidden></p>
          <div class="auth-actions">
            <button type="button" class="button ghost" id="auth-reset-back">返回</button>
            <button type="submit" class="button primary" id="auth-reset-send">发送验证码</button>
            <button type="submit" class="button primary" id="auth-reset-submit" hidden>重置密码</button>
          </div>
        </form>
        <p class="auth-footnote" id="auth-footnote">登录会保持一段时间，退出后需要重新登录。</p>
      </div>
    </div>
  </dialog>
  <template id="auth-gate-template">
    <p class="auth-gate" data-auth-gate hidden>
      <svg aria-hidden="true"><use href="#i-info"></use></svg>
      <span data-auth-gate-text></span>
      <button type="button" class="text-button auth-gate-login" data-auth-open>去登录</button>
    </p>
  </template>
