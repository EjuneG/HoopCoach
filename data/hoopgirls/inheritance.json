        <form id="auth-form" method="post" action="#auth-local" novalidate role="tabpanel" aria-labelledby="auth-tab-login">
          <div class="auth-field">
            <label for="auth-username" id="auth-username-label">用户名</label>
            <input id="auth-username" name="username" type="text" maxlength="20" autocomplete="username" autocapitalize="off" spellcheck="false" data-hint-id="auth-username-hint" aria-errormessage="auth-error">
